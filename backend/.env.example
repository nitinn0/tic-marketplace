DATABASE_URL="postgresql://tic_user:tic_password@localhost:5434/tic_marketplace_dev?schema=public"
PORT=4011
FRONTEND_URL="http://localhost:3000"
NODE_ENV="development"

# Organization invitations (optional)
# MAIL_TRANSPORT="log"                 # only "log" is implemented; emails are written to the server log
# ORG_INVITATION_TTL_HOURS=168
# ORG_INVITATION_EXPOSE_TOKEN=true     # defaults to true outside production; returns the accept link in API responses

# Seeding (optional)
# SEED_DEMO_ORGANIZATIONS=false

# e2e tests (optional; must be a local database whose name contains "test")
# TEST_DATABASE_URL="postgresql://tic_user:tic_password@localhost:5434/tic_marketplace_test?schema=public"
