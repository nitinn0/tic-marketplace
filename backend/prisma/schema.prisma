generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  phone           String?
  passwordHash    String?    @map("password_hash")
  firstName       String     @map("first_name")
  lastName        String     @map("last_name")
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?  @map("email_verified_at")
  phoneVerifiedAt DateTime?  @map("phone_verified_at")
  lastLoginAt     DateTime?  @map("last_login_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  refreshTokens           RefreshToken[]
  roles                   UserRole[]
  auditLogs               AuditLog[]               @relation("ActorAuditLogs")
  targetedAuditLogs       AuditLog[]               @relation("TargetAuditLogs")
  organizationMemberships OrganizationUser[]
  sentInvitations         OrganizationInvitation[] @relation("InvitationInvitedBy")
  acceptedInvitations     OrganizationInvitation[] @relation("InvitationAcceptedBy")
  professionalProfile     ProfessionalProfile?

  @@index([email])
  @@index([status])
  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  replacedBy String?   @map("replaced_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model ModuleEntity {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  code        String   @unique
  description String?
  icon        String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  subModules SubModule[]

  @@index([isActive])
  @@map("modules")
}

model SubModule {
  id          String   @id @default(uuid()) @db.Uuid
  moduleId    String   @map("module_id") @db.Uuid
  name        String
  code        String
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  module          ModuleEntity    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  functionalities Functionality[]

  @@unique([moduleId, code])
  @@index([moduleId])
  @@index([isActive])
  @@map("sub_modules")
}

model Functionality {
  id          String   @id @default(uuid()) @db.Uuid
  subModuleId String   @map("sub_module_id") @db.Uuid
  name        String
  code        String
  description String?
  action      String
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  subModule              SubModule               @relation(fields: [subModuleId], references: [id], onDelete: Cascade)
  accessLevelPermissions AccessLevelPermission[]
  rolePermissions        RolePermission[]

  @@unique([subModuleId, code])
  @@index([subModuleId])
  @@index([isActive])
  @@map("functionalities")
}

model AccessLevel {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  code        String   @unique
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isSystem    Boolean  @default(false) @map("is_system")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions     AccessLevelPermission[]
  roleBaselines   Role[]                  @relation("RoleBaselineAccessLevel")
  rolePermissions RolePermission[]

  @@index([code])
  @@index([isActive])
  @@map("access_levels")
}

model AccessLevelPermission {
  id              String   @id @default(uuid()) @db.Uuid
  accessLevelId   String   @map("access_level_id") @db.Uuid
  functionalityId String   @map("functionality_id") @db.Uuid
  canView         Boolean  @default(false) @map("can_view")
  canCreate       Boolean  @default(false) @map("can_create")
  canEdit         Boolean  @default(false) @map("can_edit")
  canDelete       Boolean  @default(false) @map("can_delete")
  canApprove      Boolean  @default(false) @map("can_approve")
  canConfigure    Boolean  @default(false) @map("can_configure")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  accessLevel   AccessLevel   @relation(fields: [accessLevelId], references: [id], onDelete: Cascade)
  functionality Functionality @relation(fields: [functionalityId], references: [id], onDelete: Cascade)

  @@unique([accessLevelId, functionalityId])
  @@index([accessLevelId])
  @@index([functionalityId])
  @@map("access_level_permissions")
}

model Role {
  id                    String   @id @default(uuid()) @db.Uuid
  name                  String
  code                  String   @unique
  description           String?
  category              String?
  organizationType      String?  @map("organization_type")
  baselineAccessLevelId String?  @map("baseline_access_level_id") @db.Uuid
  isSystem              Boolean  @default(false) @map("is_system")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  baselineAccessLevel     AccessLevel?             @relation("RoleBaselineAccessLevel", fields: [baselineAccessLevelId], references: [id], onDelete: SetNull)
  permissions             RolePermission[]
  userRoles               UserRole[]
  organizationUserRoles   OrganizationUserRole[]
  organizationInvitations OrganizationInvitation[]

  @@index([code])
  @@index([isActive])
  @@index([organizationType])
  @@map("roles")
}

model RolePermission {
  id              String   @id @default(uuid()) @db.Uuid
  roleId          String   @map("role_id") @db.Uuid
  functionalityId String   @map("functionality_id") @db.Uuid
  accessLevelId   String?  @map("access_level_id") @db.Uuid
  canView         Boolean? @map("can_view")
  canCreate       Boolean? @map("can_create")
  canEdit         Boolean? @map("can_edit")
  canDelete       Boolean? @map("can_delete")
  canApprove      Boolean? @map("can_approve")
  canConfigure    Boolean? @map("can_configure")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  role          Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  functionality Functionality @relation(fields: [functionalityId], references: [id], onDelete: Cascade)
  accessLevel   AccessLevel?  @relation(fields: [accessLevelId], references: [id], onDelete: SetNull)

  @@unique([roleId, functionalityId])
  @@index([roleId])
  @@index([functionalityId])
  @@map("role_permissions")
}

model UserRole {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id")
  action         String
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  targetUserId   String?  @map("target_user_id") @db.Uuid
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  actor        User?         @relation("ActorAuditLogs", fields: [actorUserId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  targetUser   User?         @relation("TargetAuditLogs", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([entityType])
  @@index([actorUserId])
  @@index([organizationId, createdAt])
  @@index([targetUserId])
  @@index([action])
  @@map("audit_logs")
}

// Additional organization types are added by extending this enum in a migration;
// roles reference the same values through roles.organization_type.
enum OrganizationType {
  BUYER
  PROVIDER
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OrganizationVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum OrganizationMembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum OrganizationInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

model Organization {
  id                 String                         @id @default(uuid()) @db.Uuid
  legalName          String                         @map("legal_name")
  displayName        String                         @map("display_name")
  organizationType   OrganizationType               @map("organization_type")
  registrationNumber String?                        @map("registration_number")
  taxId              String?                        @map("tax_id")
  website            String?
  description        String?
  countryCode        String?                        @map("country_code") @db.Char(2)
  status             OrganizationStatus             @default(ACTIVE)
  verificationStatus OrganizationVerificationStatus @default(PENDING) @map("verification_status")
  createdAt          DateTime                       @default(now()) @map("created_at")
  updatedAt          DateTime                       @updatedAt @map("updated_at")

  members         OrganizationUser[]
  invitations     OrganizationInvitation[]
  auditLogs       AuditLog[]
  providerProfile ProviderProfile?

  @@index([organizationType])
  @@index([status])
  @@index([verificationStatus])
  @@index([displayName])
  @@index([registrationNumber])
  @@map("organizations")
}

model OrganizationUser {
  id               String                       @id @default(uuid()) @db.Uuid
  organizationId   String                       @map("organization_id") @db.Uuid
  userId           String                       @map("user_id") @db.Uuid
  membershipStatus OrganizationMembershipStatus @default(INVITED) @map("membership_status")
  isOwner          Boolean                      @default(false) @map("is_owner")
  joinedAt         DateTime?                    @map("joined_at")
  invitedAt        DateTime?                    @map("invited_at")
  lastAccessedAt   DateTime?                    @map("last_accessed_at")
  createdAt        DateTime                     @default(now()) @map("created_at")
  updatedAt        DateTime                     @updatedAt @map("updated_at")

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles        OrganizationUserRole[]

  @@unique([organizationId, userId])
  @@index([userId, membershipStatus])
  @@index([organizationId, membershipStatus])
  @@index([organizationId, isOwner])
  @@map("organization_users")
}

model OrganizationUserRole {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationUserId String   @map("organization_user_id") @db.Uuid
  roleId             String   @map("role_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  organizationUser OrganizationUser @relation(fields: [organizationUserId], references: [id], onDelete: Cascade)
  role             Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([organizationUserId, roleId])
  @@index([roleId])
  @@map("organization_user_roles")
}

model OrganizationInvitation {
  id               String                       @id @default(uuid()) @db.Uuid
  organizationId   String                       @map("organization_id") @db.Uuid
  email            String
  invitedByUserId  String?                      @map("invited_by") @db.Uuid
  roleId           String                       @map("role_id") @db.Uuid
  tokenHash        String                       @unique @map("token_hash")
  expiresAt        DateTime                     @map("expires_at")
  acceptedAt       DateTime?                    @map("accepted_at")
  acceptedByUserId String?                      @map("accepted_by") @db.Uuid
  status           OrganizationInvitationStatus @default(PENDING)
  createdAt        DateTime                     @default(now()) @map("created_at")
  updatedAt        DateTime                     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InvitationInvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  acceptedBy   User?        @relation("InvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([email, status])
  @@index([expiresAt])
  @@map("organization_invitations")
}

// ---------------------------------------------------------------------------
// Phase 4: marketplace taxonomy (master data managed by platform admins)
// ---------------------------------------------------------------------------

/// Service line a category belongs to. Child categories always share their root's type.
enum ServiceCategoryType {
  CERTIFICATION
  TESTING
  INSPECTION
  CONSULTING
  OTHER
}

model ServiceCategory {
  id           String              @id @default(uuid()) @db.Uuid
  parentId     String?             @map("parent_id") @db.Uuid
  name         String
  slug         String              @unique
  description  String?
  categoryType ServiceCategoryType @map("category_type")
  active       Boolean             @default(true)
  sortOrder    Int                 @default(0) @map("sort_order")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  parent   ServiceCategory?  @relation("ServiceCategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children ServiceCategory[] @relation("ServiceCategoryHierarchy")
  services Service[]

  @@index([parentId, sortOrder])
  @@index([active])
  @@map("service_categories")
}

model Service {
  id          String   @id @default(uuid()) @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  name        String
  slug        String   @unique
  description String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category  ServiceCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  providers ProviderService[]

  @@unique([categoryId, name])
  @@index([categoryId, sortOrder])
  @@index([active])
  @@map("services")
}

model Standard {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  version     String?
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  providers ProviderStandard[]

  @@index([active])
  @@map("standards")
}

model Industry {
  id          String   @id @default(uuid()) @db.Uuid
  parentId    String?  @map("parent_id") @db.Uuid
  name        String
  slug        String   @unique
  description String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parent    Industry?          @relation("IndustryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children  Industry[]         @relation("IndustryHierarchy")
  providers ProviderIndustry[]

  @@index([parentId, sortOrder])
  @@index([active])
  @@map("industries")
}

/// A country (state/city empty), a state (city empty) or a city.
model Location {
  id          String   @id @default(uuid()) @db.Uuid
  countryCode String   @map("country_code") @db.Char(2)
  state       String?
  city        String?
  postalCode  String?  @map("postal_code")
  latitude    Float?
  longitude   Float?
  /// Normalized country|state|city|postal tuple. A plain composite unique index would not
  /// catch duplicates because PostgreSQL treats NULLs as distinct.
  locationKey String   @unique @map("location_key")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  providers ProviderLocation[]

  @@index([countryCode, state, city])
  @@index([active])
  @@map("locations")
}

// ---------------------------------------------------------------------------
// Phase 4: provider and professional profiles
// ---------------------------------------------------------------------------

enum ProviderType {
  CERTIFICATION_BODY
  TESTING_LAB
  INSPECTION_COMPANY
  CONSULTANCY
  OTHER
}

enum ProfessionalType {
  CONSULTANT
  LEAD_AUDITOR
  LEAD_VERIFIER
  INSPECTOR
  TECHNICAL_EXPERT
  OTHER
}

enum AvailabilityStatus {
  AVAILABLE
  PARTIALLY_AVAILABLE
  UNAVAILABLE
}

/// Set only by the verification workflow (Phase 5); profiles always start as PENDING.
enum ProfileVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum CoverageType {
  LOCAL
  REGIONAL
  NATIONAL
  INTERNATIONAL
}

/// Only organizations with organization_type = PROVIDER may own a provider profile (enforced in the API).
model ProviderProfile {
  id                 String                    @id @default(uuid()) @db.Uuid
  organizationId     String                    @unique @map("organization_id") @db.Uuid
  providerType       ProviderType              @map("provider_type")
  headline           String?
  description        String?
  yearsInBusiness    Int?                      @map("years_in_business")
  verificationStatus ProfileVerificationStatus @default(PENDING) @map("verification_status")
  verifiedAt         DateTime?                 @map("verified_at")
  publicProfile      Boolean                   @default(false) @map("public_profile")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  services     ProviderService[]
  standards    ProviderStandard[]
  industries   ProviderIndustry[]
  locations    ProviderLocation[]

  @@index([providerType])
  @@index([verificationStatus])
  @@index([publicProfile])
  @@map("provider_profiles")
}

model ProviderService {
  providerId String   @map("provider_id") @db.Uuid
  serviceId  String   @map("service_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service  Service         @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@id([providerId, serviceId])
  @@index([serviceId])
  @@map("provider_services")
}

/// A declared/supported standard. This is NOT an accreditation claim (Phase 5).
model ProviderStandard {
  providerId String   @map("provider_id") @db.Uuid
  standardId String   @map("standard_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  standard Standard        @relation(fields: [standardId], references: [id], onDelete: Restrict)

  @@id([providerId, standardId])
  @@index([standardId])
  @@map("provider_standards")
}

model ProviderIndustry {
  providerId String   @map("provider_id") @db.Uuid
  industryId String   @map("industry_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  industry Industry        @relation(fields: [industryId], references: [id], onDelete: Restrict)

  @@id([providerId, industryId])
  @@index([industryId])
  @@map("provider_industries")
}

model ProviderLocation {
  providerId   String        @map("provider_id") @db.Uuid
  locationId   String        @map("location_id") @db.Uuid
  coverageType CoverageType? @map("coverage_type")
  createdAt    DateTime      @default(now()) @map("created_at")

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  location Location        @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@id([providerId, locationId])
  @@index([locationId])
  @@map("provider_locations")
}

/// A professional is an individual user; no organization is required.
model ProfessionalProfile {
  id                 String                    @id @default(uuid()) @db.Uuid
  userId             String                    @unique @map("user_id") @db.Uuid
  professionalType   ProfessionalType          @map("professional_type")
  headline           String?
  bio                String?
  yearsExperience    Int?                      @map("years_experience")
  availabilityStatus AvailabilityStatus        @default(AVAILABLE) @map("availability_status")
  verificationStatus ProfileVerificationStatus @default(PENDING) @map("verification_status")
  publicProfile      Boolean                   @default(false) @map("public_profile")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")

  user       User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  experience ProfessionalExperience[]

  @@index([professionalType])
  @@index([verificationStatus])
  @@index([publicProfile])
  @@map("professional_profiles")
}

model ProfessionalExperience {
  id               String    @id @default(uuid()) @db.Uuid
  professionalId   String    @map("professional_id") @db.Uuid
  organizationName String    @map("organization_name")
  jobTitle         String    @map("job_title")
  startDate        DateTime  @map("start_date") @db.Date
  endDate          DateTime? @map("end_date") @db.Date
  description      String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId, startDate])
  @@map("professional_experience")
}
